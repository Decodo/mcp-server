SCRAPER_API_TOKEN=<token>

ENABLE_MCPS_LOGGER=false
# HTTP server (npm run dev:http / npm start)
PORT=3000
PUBLIC_URL=http://localhost:3000
# decodo | mock
OAUTH_BACKEND=decodo
DASHBOARD_AUTHORIZE_URL=https://dashboard.decodo.com/authorize
GRANT_EXCHANGE_URL=https://api.decodo.com/api/v1/grants/exchange
GRANT_EXCHANGE_SECRET=<service_credential>
OAUTH_APP_ID=mcp
# only used when OAUTH_BACKEND=mock
MOCK_SCRAPER_API_KEY=<scraping_api_key>
TRUST_PROXY=false
