SCRAPER_API_TOKEN=<token>

ENABLE_MCPS_LOGGER=false
# HTTP server (npm run dev:http / npm start)
PORT=3000
PUBLIC_URL=http://localhost:3000
OAUTH_STATE_SECRET=<random_32_bytes>
# decodo | mock
OAUTH_BACKEND=decodo
DASHBOARD_AUTHORIZE_URL=https://dashboard.decodo.com/scraper/token-exchange/decision
TOKEN_EXCHANGE_BASE_URL=https://dashboard.decodo.com/subscription-api/v1/api/scraper/apikey/token-exchange
TOKEN_EXCHANGE_CLIENT_ID=scrapper-mcp
TOKEN_EXCHANGE_KID=<kid_registered_in_subscription_api>
TOKEN_EXCHANGE_PRIVATE_KEY_FILE=/path/to/private.pem
OAUTH_ALLOWED_REDIRECT_URIS=
# only used when OAUTH_BACKEND=mock
MOCK_SCRAPER_API_KEY=<scraping_api_key>
TRUST_PROXY=false
