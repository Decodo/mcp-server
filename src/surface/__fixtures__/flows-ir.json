  "operations": {
    "scrapePage": {
      "method": "POST",
      "path": "/v1/scrape",
      "requestSchema": {
        "description": "One page to scrape, plus the shared options.",
        "allOf": [
          {
            "type": "object",
            "description": "Scraping options shared by the single and batch task requests. Mirrored from scraper-api's unified scraping parameters. The upstream\nforwards a fixed allow-list of fields to the vendor; anything else is\naccepted and silently dropped, never sent. Five niche targets (bbb,\nautotrader, mobile, airbnb, apple_app_store) are strict instead: they\nrequire url and accept only target, url, headless, geo, xhr, markdown,\ndevice_type and callback_url.\n",
            "additionalProperties": true,
            "properties": {
              "target": {
                "type": "string",
                "description": "One of the upstream's 74 targets. Disabled targets return 410. When\nomitted, universal is assumed for validation but nothing is sent, so\nthe effective default is the vendor's.\n"
              },
              "query": {
                "type": "string",
                "maxLength": 2048,
                "description": "Requires target to be set as well."
              },
              "headless": {
                "type": "string",
                "enum": ["html", "png"]
              },
              "geo": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "device_type": {
                "type": "string"
              },
              "parse": {
                "type": "boolean"
              },
              "markdown": {
                "type": "boolean"
              },
              "xhr": {
                "type": "boolean",
                "description": "Forces headless html."
              },
              "http_method": {
                "type": "string",
                "description": "GET or POST, matched case-insensitively and uppercased before forwarding."
              },
              "payload": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "description": "Checked to be an object only; values are not validated.",
                "additionalProperties": true
              },
              "cookies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "value"],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "force_headers": {
                "type": "boolean"
              },
              "force_cookies": {
                "type": "boolean"
              },
              "session_id": {
                "type": "string"
              },
              "proxy_pool": {
                "type": "string",
                "enum": ["standard", "premium"],
                "description": "Only with the universal target."
              },
              "successful_status_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "page_count": {
                "type": "integer"
              },
              "browser_actions": {
                "type": "array",
                "description": "Requires headless html.",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "custom_parsing": {
                "type": "object",
                "additionalProperties": true
              },
              "output_schema": {
                "type": "string"
              },
              "callback_url": {
                "type": "string",
                "maxLength": 255
              },
              "passthrough": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2056
              }
            }
          }
        ]
      }
    },
    "runSearch": {
      "method": "POST",
      "path": "/v1/search",
      "requestSchema": {
        "type": "object",
        "required": ["query"],
        "description": "Fields other than these are dropped before the upstream call.",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "uule": {
            "type": "string"
          },
          "gl": {
            "type": "string"
          },
          "geo": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "input_encoding": {
            "type": "string"
          },
          "page": {
            "type": "number",
            "minimum": 1,
            "description": "Not checked to be an integer; forwarded as given."
          }
        }
      }
    },
    "mapSite": {
      "method": "POST",
      "path": "/v1/map",
      "requestSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "Absolute http or https URL to map."
          },
          "limit": {
            "type": "integer",
            "description": "Maximum links to return. Zero, negative or above 147700 all become 147700; nothing is rejected.",
            "default": 147700
          },
          "sitemap": {
            "type": "string",
            "enum": ["include", "only", "skip"],
            "default": "include"
          },
          "domain_filter": {
            "type": "string",
            "enum": ["domain", "subdomain", "all"],
            "default": "domain"
          },
          "geo": {
            "type": "string"
          },
          "locale": {
            "type": "string"
          },
          "JS_rendering": {
            "type": "boolean",
            "default": false
          },
          "follow_redirects": {
            "type": "boolean",
            "default": true
          },
          "select_paths": {
            "description": "Either one pattern or a list of them. Each must compile as a Go regular expression.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "exclude_paths": {
            "description": "Either one pattern or a list of them. Each must compile as a Go regular expression.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "queueTask": {
      "method": "POST",
      "path": "/v1/task",
      "requestSchema": {
        "description": "One page to scrape, plus the shared options.",
        "allOf": [
          {
            "type": "object",
            "description": "Scraping options shared by the single and batch task requests. Mirrored from scraper-api's unified scraping parameters. The upstream\nforwards a fixed allow-list of fields to the vendor; anything else is\naccepted and silently dropped, never sent. Five niche targets (bbb,\nautotrader, mobile, airbnb, apple_app_store) are strict instead: they\nrequire url and accept only target, url, headless, geo, xhr, markdown,\ndevice_type and callback_url.\n",
            "additionalProperties": true,
            "properties": {
              "target": {
                "type": "string",
                "description": "One of the upstream's 74 targets. Disabled targets return 410. When\nomitted, universal is assumed for validation but nothing is sent, so\nthe effective default is the vendor's.\n"
              },
              "query": {
                "type": "string",
                "maxLength": 2048,
                "description": "Requires target to be set as well."
              },
              "headless": {
                "type": "string",
                "enum": ["html", "png"]
              },
              "geo": {
                "type": "string"
              },
              "locale": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "device_type": {
                "type": "string"
              },
              "parse": {
                "type": "boolean"
              },
              "markdown": {
                "type": "boolean"
              },
              "xhr": {
                "type": "boolean",
                "description": "Forces headless html."
              },
              "http_method": {
                "type": "string",
                "description": "GET or POST, matched case-insensitively and uppercased before forwarding."
              },
              "payload": {
                "type": "string"
              },
              "headers": {
                "type": "object",
                "description": "Checked to be an object only; values are not validated.",
                "additionalProperties": true
              },
              "cookies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["key", "value"],
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": "string"
                    }
                  }
                }
              },
              "force_headers": {
                "type": "boolean"
              },
              "force_cookies": {
                "type": "boolean"
              },
              "session_id": {
                "type": "string"
              },
              "proxy_pool": {
                "type": "string",
                "enum": ["standard", "premium"],
                "description": "Only with the universal target."
              },
              "successful_status_codes": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "page_count": {
                "type": "integer"
              },
              "browser_actions": {
                "type": "array",
                "description": "Requires headless html.",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "custom_parsing": {
                "type": "object",
                "additionalProperties": true
              },
              "output_schema": {
                "type": "string"
              },
              "callback_url": {
                "type": "string",
                "maxLength": 255
              },
              "passthrough": {
                "type": "string",
                "maxLength": 1024
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2056
              }
            }
          }
        ]
      }
    },
    "getTask": {
      "method": "GET",
      "path": "/v1/task/{id}"
    },
    "getTaskResults": {
      "method": "GET",
      "path": "/v1/task/{id}/results"
    },
    "startCrawl": {
      "method": "POST",
      "path": "/v1/crawl",
      "requestSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "An http or https URL with a host. URLs carrying credentials (user:pass@) are refused."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 10
          },
          "max_depth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000,
            "default": 5
          },
          "sitemap": {
            "type": "string",
            "enum": ["include", "only", "skip"],
            "default": "include"
          },
          "domain_filter": {
            "type": "string",
            "enum": ["domain", "subdomain", "all"],
            "default": "domain"
          },
          "output": {
            "type": "string",
            "enum": ["markdown", "html"],
            "default": "markdown"
          },
          "geo": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z .'-]{0,58}[A-Za-z]$",
            "description": "Letters, spaces, dots, apostrophes and hyphens, 2 to 60 characters."
          },
          "locale": {
            "type": "string",
            "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "description": "BCP 47 style, for example en or de-DE."
          },
          "follow_redirects": {
            "type": "boolean"
          },
          "JS_retry": {
            "type": "boolean"
          },
          "max_duration": {
            "type": "integer",
            "minimum": 0,
            "maximum": 14400,
            "description": "Seconds. 0 means the server default. Rejected above the server's ceiling, 4 hours by default; the ceiling is configurable per environment.",
            "default": 3600
          },
          "callback_url": {
            "type": "string",
            "description": "http or https URL called when the crawl settles. Internal addresses are refused."
          },
          "passthrough": {
            "type": "string",
            "maxLength": 8192,
            "description": "Opaque value echoed back on the callback, at most 8192 bytes. Redacted in logs."
          },
          "select_paths": {
            "description": "Either one pattern or a list of them. Each must compile as a Go regular expression.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "exclude_paths": {
            "description": "Either one pattern or a list of them. Each must compile as a Go regular expression.",
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    },
    "getCrawlStatus": {
      "method": "GET",
      "path": "/v1/crawl/{id}/status"
    },
    "listCrawlPages": {
      "method": "GET",
      "path": "/v1/crawl/{id}"
    },
    "cancelCrawl": {
      "method": "POST",
      "path": "/v1/crawl/{id}/cancel"
    },
    "queueTaskBatch": {
      "method": "POST",
      "path": "/v1/task/batch",
      "requestSchema": {
        "description": "Same options as ScrapeOptions but lighter validation: only url\nentries (2056 chars), callback_url (255) and geo are checked, plus the\nproxy_pool and browser_actions rules. Do not append a query string to\nthe request path /v1/task/batch; the upstream then treats the request\nas a single task.\nSend exactly one of url, query, prompt or product_id, each an array where\nScrapeOptions takes a single value. On the batch rollout, each entry\nbecomes one task and is capped at 8 KB, and a request holds at most\n5,000 tasks unless the account's limits say otherwise.\n",
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "target": {
            "type": "string"
          },
          "url": {
            "type": "array",
            "description": "The pages to scrape. Invalid entries are skipped, not rejected, unless all are invalid.",
            "items": {
              "type": "string",
              "maxLength": 2056
            }
          },
          "query": {
            "type": "array",
            "description": "Search queries, for search targets.",
            "items": {
              "type": "string"
            }
          },
          "prompt": {
            "type": "array",
            "description": "Prompts, for AI targets such as chatgpt and perplexity.",
            "items": {
              "type": "string"
            }
          },
          "product_id": {
            "type": "array",
            "description": "Product IDs, for store targets like Walmart",
            "items": {
              "type": "string"
            }
          },
          "callback_url": {
            "type": "string",
            "maxLength": 255
          },
          "passthrough": {
            "type": "string"
          }
        }
      }
    }
  },
  "flows": {
    "scrape": {
      "pattern": "call",
      "run": "scrapePage"
    },
    "search": {
      "pattern": "call",
      "run": "runSearch"
    },
    "map": {
      "pattern": "call",
      "run": "mapSite"
    },
    "task": {
      "pattern": "job",
      "start": "queueTask",
      "status": "getTask",
      "results": "getTaskResults",
      "idField": "id",
      "statusField": "status",
      "pendingStatuses": ["pending"],
      "failedStatuses": ["faulted"],
      "pollSeconds": 5
    },
    "crawl": {
      "pattern": "job",
      "start": "startCrawl",
      "status": "getCrawlStatus",
      "results": "listCrawlPages",
      "cancel": "cancelCrawl",
      "idField": "crawl_id",
      "statusField": "status",
      "pendingStatuses": ["pending"],
      "failedStatuses": ["faulted", "cancelled"],
      "resultsQuery": {
        "type": "content"
      },
      "pagination": {
        "itemsField": "url",
        "nextUrlField": "next"
      },
      "pollSeconds": 5
    },
    "task_batch": {
      "pattern": "batch",
      "start": "queueTaskBatch",
      "itemsField": "queries",
      "job": "task"
    }
  },
  "keyCheck": {
    "flow": "scrape",
    "params": {
      "target": "universal",
      "url": "https://does-not-exist.decodo.com"
    }
  },
  "surfaces": {
    "mcp": {
      "tools": [
        {
          "name": "scrape_as_markdown",
          "title": "Scrape as Markdown",
          "description": "Fetch any public web page through the Decodo Web Data API (`universal` target) and return its content as Markdown. Use it to read a specific URL when no site-specific tool fits; very long pages are truncated, and `tokenLimit` sets a lower cap. Docs: https://help.decodo.com/docs/web-data-api-markdown-response",
          "group": "web",
          "flow": "scrape",
          "target": "universal",
          "fields": ["url", "geo", "locale", "headless"],
          "required": ["url"],
          "fixed": {
            "target": "universal"
          },
          "choices": {
            "headless": ["html"]
          },
          "descriptions": {
            "url": "URL to scrape",
            "geo": "Geolocation of the desired request, expressed as a country name",
            "locale": "Locale of the desired request",
            "headless": "Set to 'html' to open the page in a headless browser; leave it out otherwise"
          },
          "result": {
            "failures": [
              {
                "path": "status",
                "equals": "failed",
                "message": "message",
                "code": "status_code",
                "retryable": true
              },
              {
                "path": "results.0.status_code",
                "atLeast": 400
              }
            ],
            "from": "results.0.content"
          },
          "limits": {
            "maxTextChars": 45000
          }
        },
        {
          "name": "screenshot",
          "title": "Screenshot",
          "description": "Capture a PNG screenshot of a web page through the Decodo Web Data API (`universal` target with PNG output). Use it when the page layout or visuals matter, not just its text. Docs: https://help.decodo.com/docs/web-data-api-screenshot-response",
          "group": "web",
          "flow": "scrape",
          "target": "universal",
          "fields": ["url", "geo"],
          "required": ["url"],
          "fixed": {
            "target": "universal",
            "headless": "png"
          },
          "descriptions": {
            "url": "URL to screenshot",
            "geo": "Geolocation of the desired request, expressed as a country name"
          },
          "result": {
            "failures": [
              {
                "path": "status",
                "equals": "failed",
                "message": "message",
                "code": "status_code",
                "retryable": true
              },
              {
                "path": "results.0.status_code",
                "atLeast": 400
              }
            ],
            "from": "results.0.content"
          }
        },
        {
          "name": "map",
          "title": "Map Website",
          "description": "List the URLs on a website without fetching their content. Large sites can overflow your context, so `limit` defaults to 10; narrow with select_paths or exclude_paths. For precise work, map the site, then scrape_as_markdown only the pages you need.",
          "group": "web",
          "flow": "map",
          "fields": [
            "url",
            "limit",
            "sitemap",
            "domain_filter",
            "select_paths",
            "exclude_paths",
            "geo",
            "locale"
          ],
          "defaults": {
            "limit": 10
          },
          "minimums": {
            "limit": 1
          },
          "maximums": {
            "limit": 500
          },
          "descriptions": {
            "url": "Website URL to map",
            "limit": "Maximum number of URLs to return, 10 by default and at most 500",
            "sitemap": "Whether to use the sitemap alongside links found on pages, only the sitemap, or skip it",
            "domain_filter": "Which links to follow: the same domain, its subdomains too, or any domain",
            "select_paths": "Only keep URLs whose path matches one of these patterns, e.g. ^/blog",
